  "description": "A canvas of linked cards kept as a JSON Canvas file, with shared gestures, alignment guides, automatic layout and undo.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/nyssance/metro.git"
  },
