    "test": "bun test --parallel"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.0",
    "@xyflow/react": "^13.0.3",
    "elkjs": "^0.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
