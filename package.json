    "./canvas": "./src/canvas.tsx",
    "./controls": "./src/controls.ts",
    "./grid": "./src/grid.ts",
    "./history": "./src/history.ts",
    "./presets/*.css": "./src/presets/*.css",
    "./snap": "./src/snap.tsx",
    "./tidy": "./src/tidy.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
